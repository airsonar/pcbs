		)
		(uuid "3550e726-49f0-44de-bf07-5b194222ad55")
	)
	(text_box "M3 mounting holes. Electrically isolated but with a number of vias in the pad for strength against crushing."
		(exclude_from_sim no)
		(at 133.985 116.205 0)
		(size 40.005 7.62)
		(margins 0.9524 0.9524 0.9524 0.9524)

	(text_box "JMA* connectors have SEL grounded. JMB* connectors have SEL connected to VDD. The data lines between corresponding A and B connectors are connected to the same Zybo pins."
		(exclude_from_sim no)
		(at 186.055 20.32 0)
		(size 92.71 5.08)
		(margins 0.9524 0.9524 0.9524 0.9524)

		(uuid "4160b555-f4fc-4141-a98e-3f6577964974")
	)
	(text_box "J*1 are the pin headers connecting to the Zybo board.\nJ*2 are IDC headers duplicating the Zybo header to enable further development.\nNote that on the -10 version of the board, JB is not present (and so microphone boards 4A and 4B cannot be used)."
		(exclude_from_sim no)
		(at 31.75 19.05 0)
		(size 81.28 9.525)
		(margins 0.9524 0.9524 0.9524 0.9524)
